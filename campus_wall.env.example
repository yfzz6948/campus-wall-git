# 校园信息墙环境变量示例
# 用法：复制为 campus_wall.env，填入真实值，权限设为 600（chmod 600 campus_wall.env）
# 两台 Web 服务器的本文件内容必须【完全一致】（SECRET_KEY/DB_PASSWORD 相同）

# 数据库地址：数据库本机部署 Web 填 127.0.0.1；另一台 Web 填数据库机的内网 IP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campus_wall
DB_PASSWORD=请改成强密码
DB_NAME=campus_wall

# Flask Session 签名密钥：两台必须相同，否则登录状态在两台机器间随机失效
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为上面命令生成的64位随机字符串
# 注意：这一项留空或保留默认值时，应用会拒绝启动/拒绝服务，不会带着公开密钥裸奔。

# 可选：只在纯 HTTPS（没有 Tor http 入口）部署时设为 1，给会话 Cookie 加 Secure
# COOKIE_SECURE=1

# 可选：哪些域名算"站内"（站内链接不经过外链提示页，直接跳转）
# 默认已是 y4006948.com,www.y4006948.com；当前请求的 Host 也会自动算站内（含 Tor 域名）
# SITE_HOSTS=y4006948.com,www.y4006948.com

# 登录人机验证（Cloudflare Turnstile，不可见模式）
# 到 Cloudflare 控制台：Turnstile → 添加站点 → 拿到 Site Key 与 Secret Key。
# 两项都填了才生效；留空则登录不做验证（本机开发就该留空）。
# .onion 与 localhost 会自动跳过——那里连不到 challenges.cloudflare.com。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 可选：隐私政策页 /privacy 上展示的联系邮箱。
# 支持写多个，用逗号/分号/顿号/斜杠/空白/中文「或」隔开
# （页面上会各自渲染成独立链接，不会拼成一个畸形 mailto）：
#   PRIVACY_CONTACT_EMAIL=admin@example.com或ops@example.com
# 留空则只显示"站内联系管理员"；写错的项会被静默丢掉，不会展示。
#
# 可选：电话联系方式，会渲染成 tel: 链接 + WhatsApp 链接，
# 并注明"可发短信、也可用 WhatsApp 发消息至该号码"。
# 建议写国际格式；只写 11 位手机号会按 +86 处理。多个号码不支持（只取第一个有效的）。
# PRIVACY_CONTACT_PHONE=+8613800138000
