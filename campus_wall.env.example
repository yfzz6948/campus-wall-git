# 校园信息墙环境变量示例
# 用法：复制为 campus_wall.env，填入真实值，权限设为 600（chmod 600 campus_wall.env）
# 两台 Web 服务器的本文件内容必须【完全一致】（SECRET_KEY/DB_PASSWORD 相同）

# 数据库地址：数据库本机部署 Web 填 127.0.0.1；另一台 Web 填数据库机的内网 IP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campus_wall
DB_PASSWORD=请改成强密码
DB_NAME=campus_wall

# Flask Session 签名密钥：两台必须相同，否则登录状态在两台机器间随机失效
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为上面命令生成的64位随机字符串
